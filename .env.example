# Machine that runs the bot: mac (launchd) or windows (Task Scheduler). Empty = this machine.
# The bot refuses to run on any other OS. Install its scheduler: uv run python -m bot.host install
BOT_HOST=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
PAPER=true
DRY_RUN=true

SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#trading-bot
# Council of Ricks messages only (pretend trades, summaries, scorecard, council health). Empty = SLACK_CHANNEL.
COUNCIL_SLACK_CHANNEL=
# Health checks and reports (health report, learning digest, scorecard). Empty = SLACK_CHANNEL.
GENERAL_SLACK_CHANNEL=
# Queue messages and send them from a separate task (docs/06-alerts.md). Off by default.
NOTIFY_VIA_OUTBOX=false

CLAUDE_USAGE_SNAPSHOT=~/.local/state/stocktradingbot/claude_usage.json
CLAUDE_ROUTINE_DAILY_URL=
CLAUDE_ROUTINE_DAILY_TOKEN=
CLAUDE_ROUTINE_WEEKLY_URL=
CLAUDE_ROUTINE_WEEKLY_TOKEN=

SEC_USER_AGENT="StockTradingBot your-email@example.com"
QUIVER_API_KEY=

# Optional (defaults shown)
# TRADING_MODE=swing            # swing (daily bars, default) | intraday (5-minute bars, flat by 15:50; docs/17)
#                               # | overnight (buy at the close, sell at the next open; paper only; docs/19-overnight-hold.md)
# All options: docs/settings.md
# STRATEGY=trend_pullback       # swing: trend_pullback | confluence_reversion | rsi2_reversion | ibs_reversion | high_momentum | analyst_desk | kronos_rank
#                               # intraday: orb_breakout (default) | gap_fill | intraday_reversion | late_momentum | ...
#                               # overnight: overnight_hold (the only one)
# STRATEGY_CANDIDATES=          # comma list bot.compare backtests and suggests from (empty = all)
# UNIVERSE=sp100               # sp100 (default) | sp500; evidence must be backtested with --universe on the same list
# kronos_rank only (opt-in experiment, docs/12-strategies.md); empty = strategy defaults
# SENTIMENT_EXIT=false         # swing mode: sell held stocks on a fresh Stocktwits sell_warning (docs/20-sentiment.md)
# SENTIMENT_MAX_AGE_MIN=90      # ignore snapshots older than this many minutes
# KRONOS_FORECASTS=data/kronos/forecasts.csv   # forecast cache written by python -m bot.kronos
# KRONOS_MIN_P_UP=0.6           # min share of sampled paths ending higher (0.5-1)
# KRONOS_MIN_FRET=0.01          # min mean forecast return over 5 days (>= 0)
# KRONOS_SRC=~/Development/Kronos   # Kronos repo checkout used by python -m bot.kronos
# GATE_MODE=win_rate            # win_rate (60%/60% rule) | expectancy (owner's alternative, see AGENTS.md)
# EARNINGS_POLICY=flag          # flag: trade and flag unknown earnings dates; strict: no trade
# ALTDATA_FEATURES=             # comma list, e.g. news_shock_veto (off until backtested)
# LIVE_DATA_FEED=iex            # free plan real-time quotes
# BOT_DB=data/bot.db
# Risk limits can only be tightened (ceilings: 0.01 / 0.20 / 6)
# RISK_PER_TRADE=0.01
# MAX_POSITION_PCT=0.20
# MAX_OPEN_POSITIONS=6
